# .env.example — math_game_v2 local configuration template
#
# Copy this file to .env and edit as needed for your local setup.
# The .env file is loaded automatically by python-dotenv at startup.
#
# IMPORTANT: Never commit .env to version control.
#            This file (.env.example) is safe to commit — it contains no secrets.
#
# For local development, the defaults in config.py are fine.
# You only need a .env if you want to override the defaults.
#

# ── Secret key ─────────────────────────────────────────────────────────────────
# Used to sign session cookies and CSRF tokens.
# CHANGE THIS in any environment that is not purely local/offline dev.
# SECRET_KEY=dev-secret-change-before-deployment

# ── Database ───────────────────────────────────────────────────────────────────
# Default: SQLite at instance/math_game.db (relative to the instance/ folder).
# Override only if using a different DB or location.
# DATABASE_URL=sqlite:///math_game.db

# ── Socket.IO async mode ───────────────────────────────────────────────────────
# Default: 'threading' (works out of the box with simple-websocket).
# Change to 'gevent' only if gevent is installed and tested.
# SOCKETIO_ASYNC_MODE=threading
