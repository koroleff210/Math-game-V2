# .env.example — math_game_v2 local configuration template
#
# Copy this file to .env and edit as needed for your local setup.
# The .env file is loaded automatically by python-dotenv at startup.
#
# IMPORTANT: Never commit .env to version control.
#            This file (.env.example) is safe to commit — it contains no secrets.
#
# For local development, the defaults in config.py are fine.
# You only need a .env if you want to override the defaults.
#

# ── Secret key ─────────────────────────────────────────────────────────────────
# Used to sign session cookies and CSRF tokens.
# CHANGE THIS in any environment that is not purely local/offline dev.
# SECRET_KEY=dev-secret-change-before-deployment

# ── Database ───────────────────────────────────────────────────────────────────
# Default: SQLite at instance/math_game.db (relative to the instance/ folder).
# Override only if using a different DB or location.
# DATABASE_URL=sqlite:///math_game.db

# ── Socket.IO async mode ───────────────────────────────────────────────────────
# Default: 'threading' (works out of the box with simple-websocket).
# Change to 'gevent' only if gevent is installed and tested.
# SOCKETIO_ASYNC_MODE=threading

# Self-hosted Docker Compose pilot: copy this file to .env on the Ubuntu server,
# then uncomment and fill every setting below. Keep .env private (chmod 600).
# Use URL-safe hexadecimal for POSTGRES_PASSWORD because Compose places it in
# DATABASE_URL. Generate it with: openssl rand -hex 32
# GAME_DOMAIN=game.example.com
# POSTGRES_DB=math_game
# POSTGRES_USER=math_game
# POSTGRES_PASSWORD=<random URL-safe hexadecimal value>
# SECRET_KEY=<random value from openssl rand -hex 32>
# INITIAL_ADMIN_USERNAME=<new admin username>
# INITIAL_ADMIN_PASSWORD=<unique password of at least 12 characters>
# GAME_ENV=production
# DATABASE_URL=postgresql+psycopg://math_game:<URL-safe password>@postgres:5432/math_game
# GAME_PUBLIC_ORIGINS=https://game.example.com
# GAME_MEDIA_ROOT=/data/media
# GAME_INSTANCE_PATH=/var/lib/korephysics-game
# GAME_IDENTITY_URL=http://127.0.0.1:5061
# GAME_IDENTITY_TOKEN=<private shared bridge token>
# GAME_MAX_REQUEST_BYTES=134217728
# GAME_IMPORT_MAX_FILES=6000
# GAME_IMPORT_MAX_EXPANDED_BYTES=268435456
# Compose sets GAME_ENV, DATABASE_URL, GAME_PUBLIC_ORIGINS, and GAME_MEDIA_ROOT
# for the web service. Keep these examples commented when using Compose.
# The upload limits use the defaults above unless explicitly overridden.
