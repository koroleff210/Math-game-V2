[Unit]
Description=Private shared student identity adapter
After=network.target

[Service]
User=korephysics
Group=korephysics
WorkingDirectory=/opt/korephysics-game/app
EnvironmentFile=/etc/korephysics-game/identity.env
Environment=PYTHONPATH=/opt/korephysics/app:/opt/korephysics-game/app
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/korephysics/venv/bin/python -c "from deploy.identity_gateway import create_gateway; from waitress import serve; serve(create_gateway(), host='127.0.0.1', port=5061, threads=8)"
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/korephysics/instance

[Install]
WantedBy=multi-user.target
